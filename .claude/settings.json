{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "permissions": {
    "ask": [
      "Edit(./eslint.config.js)",
      "Write(./eslint.config.js)",
      "Edit(./scripts/guard.js)",
      "Write(./scripts/guard.js)",
      "Edit(./scripts/guardrails.json)",
      "Write(./scripts/guardrails.json)",
      "Edit(./scripts/mutate.js)",
      "Write(./scripts/mutate.js)",
      "Edit(./scripts/mutants.json)",
      "Write(./scripts/mutants.json)",
      "Edit(./scripts/spec-check.js)",
      "Write(./scripts/spec-check.js)",
      "Edit(./tests/run.js)",
      "Write(./tests/run.js)",
      "Edit(./tests/helpers/meet.js)",
      "Write(./tests/helpers/meet.js)",
      "Edit(./tests/helpers/content.js)",
      "Write(./tests/helpers/content.js)",
      "Edit(./tests/helpers/mock-meet.js)",
      "Write(./tests/helpers/mock-meet.js)",
      "Edit(./tests/sync-roster.test.js)",
      "Write(./tests/sync-roster.test.js)",
      "Edit(./tests/keys-diag.test.js)",
      "Write(./tests/keys-diag.test.js)",
      "Edit(./tests/ui-backfill.test.js)",
      "Write(./tests/ui-backfill.test.js)",
      "Edit(./tests/sync-backfill.test.js)",
      "Write(./tests/sync-backfill.test.js)",
      "Edit(./tests/content-policy.test.js)",
      "Write(./tests/content-policy.test.js)",
      "Edit(./tests/features.test.js)",
      "Write(./tests/features.test.js)",
      "Edit(./tests/lint-bypass.test.js)",
      "Write(./tests/lint-bypass.test.js)",
      "Edit(./tests/markup-variants.test.js)",
      "Write(./tests/markup-variants.test.js)",
      "Edit(./tests/remove-clear-sync.test.js)",
      "Write(./tests/remove-clear-sync.test.js)",
      "Edit(./tests/roster-sync.test.js)",
      "Write(./tests/roster-sync.test.js)",
      "Edit(./tests/safety.test.js)",
      "Write(./tests/safety.test.js)",
      "Edit(./tests/trusted-types.test.js)",
      "Write(./tests/trusted-types.test.js)",
      "Edit(./tests/picker-styles.test.js)",
      "Write(./tests/picker-styles.test.js)",
      "Edit(./.githooks/pre-commit)",
      "Write(./.githooks/pre-commit)",
      "Edit(./.githooks/commit-msg)",
      "Write(./.githooks/commit-msg)",
      "Edit(./.githooks/pre-push)",
      "Write(./.githooks/pre-push)",
      "Edit(./.github/workflows/ci.yml)",
      "Write(./.github/workflows/ci.yml)",
      "Edit(./.github/pull_request_template.md)",
      "Write(./.github/pull_request_template.md)",
      "Edit(./.claude/settings.json)",
      "Write(./.claude/settings.json)",
      "Edit(./.claude/commands/spec.md)",
      "Write(./.claude/commands/spec.md)",
      "Edit(./.claude/commands/implement.md)",
      "Write(./.claude/commands/implement.md)",
      "Edit(./package.json)",
      "Write(./package.json)",
      "Edit(./.git/**)",
      "Write(./.git/**)",
      "Edit(./scripts/guardrails.lock.json)",
      "Write(./scripts/guardrails.lock.json)"
    ],
    "deny": [
      "Bash(git commit --no-verify:*)",
      "Bash(git commit -n:*)",
      "Bash(git push --no-verify:*)",
      "Bash(git push --force:*)",
      "Bash(git push -f:*)",
      "Bash(git config core.hooksPath:*)",
      "Bash(git -c core.hooksPath:*)",
      "Bash(git -c core.hookspath:*)",
      "Bash(HUSKY=0:*)",
      "Bash(node scripts/guard.js --relock:*)",
      "Bash(npm run guard -- --relock:*)"
    ]
  },
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Edit|Write|MultiEdit|NotebookEdit",
        "hooks": [
          {
            "type": "command",
            "command": "cd \"$CLAUDE_PROJECT_DIR\" && node scripts/spec-check.js --hook"
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "Edit|Write|MultiEdit",
        "hooks": [
          {
            "type": "command",
            "command": "cd \"$CLAUDE_PROJECT_DIR\" && { npm run -s check && npx eslint . && node scripts/guard.js; } 1>&2 || exit 2"
          }
        ]
      }
    ]
  }
}
